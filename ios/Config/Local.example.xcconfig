// Copy this file to Local.xcconfig (git-ignored) and fill in your values.

// Must match the iOS app you registered in the Firebase console.
PRODUCT_BUNDLE_IDENTIFIER = com.yourname.expensetracker

// Your Apple developer team ID (Xcode > Settings > Accounts). Needed to run on a real device.
DEVELOPMENT_TEAM =

// REVERSED_CLIENT_ID from GoogleService-Info.plist.
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.1234567890-abcdefghijklmnop
